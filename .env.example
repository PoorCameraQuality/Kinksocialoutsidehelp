# Kink.social env template (Vite web + Fastify API)
# Copy values into gitignored `.env.local` / `.env.development.local` for overrides.
# Committed local defaults: `.env.development`
# Production host template: `.env.production.example`

# Required in production: HMAC secret for signed `c2k_session` cookie.
# Development defaults to an insecure placeholder if unset (do not ship that).
AUTH_SECRET=

# Cookie signing (production). Separate from AUTH_SECRET.
# COOKIE_SECRET=

# Dev: fallback session is ON unless this is the string "false".
# Production: must not be "true" (API refuses startup if explicitly enabled).
# AUTH_ALLOW_FALLBACK=false
# VITE_AUTH_ALLOW_FALLBACK=false

# Database (local Compose uses host port 6432 — see .env.development)
# USE_DATABASE=true
# DATABASE_URL=postgresql://c2k:c2k_dev@127.0.0.1:6432/c2k?sslmode=disable
# REDIS_URL=redis://127.0.0.1:6379

# Vite web
# VITE_API_URL=http://127.0.0.1:3001
# VITE_SITE_URL=http://127.0.0.1:5173
# VITE_PUBLIC_LAUNCH=false
# VITE_LEGAL_PUBLISHED=false

# Demo seed login password (optional; defaults to "demo")
# DEMO_LOGIN_PASSWORD=demo

# Object storage (local MinIO — see .env.development)
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=c2k
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Mail (local Mailpit)
# C2K_MAIL_TRANSPORT=smtp
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025

# ECKE outbound publish (never commit real secrets)
# ECKE_PUBLISH_ENABLED=false
# ECKE_PUBLISH_ENDPOINT=
# ECKE_PUBLISH_SECRET=
# ECKE_PUBLISH_HMAC_SECRET=

# Stripe Connect (per-org; see docs/adr/006-stripe-connect-per-org.md)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Production-required when USE_DATABASE=true (see .env.production.example)
# C2K_FIELD_ENCRYPTION_KEY=
# EMAIL_LOOKUP_PEPPER=
# EXTERNAL_STORE_SECRET=
